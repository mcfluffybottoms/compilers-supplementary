-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine instructions
fun isEmpty (l) {
   case l of
     {} -> true
   | _  -> false
   esac
}
fun max (a, b) {
   if a > b then a else b fi
}
-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
   fun label (lab, labUsed) {
      if labUsed then singletonBuffer(LABEL(lab, false)) else emptyBuffer() fi
   }
   fun compileMany (lab, env, exprs) {
      case exprs of
        {e}   -> compile(lab, env, e)
      | e: es -> case env.genLabel of
                   [eLab, env] -> case compile(eLab, env, e) of
                                    [eUsed, env, eCode] -> case compileMany(lab, env, es) of
                                                             [labUsed, env, esCode] -> [labUsed, env, eCode <+> label(eLab,
                                                                                                        eUsed) <+> esCode]
                                                           esac
                                  esac
                 esac
      esac
   }
   fun addGlobals (env, n) {
      foldl(fun (code, name) {code <+ GLOBAL(name)}, emptyBuffer(), n)
   }
   fun addDefs (env, defs) {
      foldl(fun ([env, code], def) {
           case def of
             Fun(n, args, body) -> let [fLabel, env] = genLabel(env) in [addFun(env, n, fLabel, args.size), code]
           | Var(n)             -> [addVars(env, n), if isGlobal(env) then code <+> addGlobals(env, n) else code fi]
           | Val(n)             -> [addVals(env, n), if isGlobal(env) then code <+> addGlobals(env, n) else code fi]
           esac
        }, [env, emptyBuffer()], defs)
   }
   fun rememberFuns (env, defs) {
      foldl(fun (env, def) {
           case def of
             Fun(n, args, body) -> let Fun(fLabel, _) = lookupFun(env, n) in rememberFun(env, fLabel, args, body)
           | _                  -> env
           esac
        }, env, defs)
   }
   fun compileDefs (env, ds) {
      case addDefs(env, ds) of
        [env, code] -> [rememberFuns(env, ds), code]
      esac
   }
   fun compile (lab, env, stmt) {
      case stmt of
        Skip                     -> [false, env, emptyBuffer()]
      | Var(x)                   -> [false, env, singletonBuffer(LD(lookupVal(env, x)))]
      | Val(x)                   -> [false, env, singletonBuffer(LD(lookupVal(env, x)))]
      | Ref(x)                   -> [false, env, singletonBuffer(LDA(lookupVar(env, x))) <+ DUP]
      | Const(n)                 -> [false, env, singletonBuffer(CONST(n))]
      | Assn(Ref(x), e)          -> let [eLab, env] = genLabel(env) in
                                       let [labUsed, env, code] = compile(eLab, env, e) in
                                          [false, env, code <+> label(eLab, labUsed) <+ ST(lookupVar(env, x))]
      | Assn(er, e)              -> case genLabel(env) of
                                      [eLab, env] -> case compileMany(eLab, env, {er, e}) of
                                                       [labUsed, newEnv, code] -> [false,
                                                                                   newEnv,
                                                                                   (code <+> label(eLab, labUsed)) <+ STA]
                                                     esac
                                    esac
      | Binop(op, l, r)          -> let [lLab, rLab, env] = env.genLabels(2) in
                                       let [lLabUsed, env, lCode] = compile(lLab, env, l) in
                                          let [rLabUsed, env, rCode] = compile(rLab, env, r) in
                                             [false, env, lCode <+> label(lLab, lLabUsed) <+> rCode <+> label(rLab,
                                                            rLabUsed) <+ BINOP(op)]
      | Seq(s1, s2)              -> let [s2Lab, env] = env.genLabel in
                                       let [s2LabUsed, env, s1Code] = compile(s2Lab, env, s1) in
                                          let [labUsed, env, s2Code] = compile(lab, env, s2) in
                                             [labUsed, env, s1Code <+> label(s2Lab, s2LabUsed) <+> s2Code]
      | If(expr, s1, s2)         -> let [condLabel, elseLabel, env] = env.genLabels(2) in
                                       let [condUsed, env, condCode] = compile(lab, env, expr) in
                                          let [_, env, thenCode] = compile(lab, env, s1) in
                                             let [_, env, elseCode] = compile(lab, env, s2) in
                                                [true, env, condCode <+> label(condLabel, condUsed) <+ CJMP("z",
                                                                 elseLabel) <+> thenCode <+ JMP(lab) <+ LABEL(elseLabel,
                                                                  false) <+> elseCode]
      | While(expr, s)           -> let [bodyLabel, condLabel1, condLabel2, env] = env.genLabels(3) in
                                       let [_, env, bodyCode] = compile(condLabel1, env, s) in
                                          let [condUsed2, env, condCode] = compile(condLabel2, env, expr) in
                                             [false, env, singletonBuffer(JMP(condLabel1)) <+ LABEL(bodyLabel,
                                                                true) <+> bodyCode <+ LABEL(condLabel1,
                                                                false) <+> condCode <+> label(condLabel2,
                                                            condUsed2) <+ CJMP("nz", bodyLabel)]
      | DoWhile(expr, s)         -> compile(lab, env, Seq(s, While(expr, s)))
      | Ignore(expr)             -> let [labUsed, env, code] = compile(lab, env, expr) in
                                       [false, env, code <+> label(lab, labUsed) <+ DROP]
      | Scope(defs, e)           -> let [env, defsCode] = compileDefs(beginScope(env), defs) in
                                       let [labUsed, env, envCode] = compile(lab, env, e) in
                                          [labUsed, endScope(env), defsCode <+> envCode]
      | Call(x, exprs)           -> let Fun(xLabel, xSize) = env.lookupFun(x) in
                                       let [env, exprsCode] = foldl(fun ([env, exprsCode], expr) {
                                                                   let [exprLabel, env] = genLabel(env) in
                                                                      let [exprLabelUsed,
                                                                           env,
                                                                           exprCode] = compile(exprLabel, env, expr) in
                                                                         [env, exprsCode <+> exprCode <+> label(exprLabel,
                                                                                 exprLabelUsed)]
                                                                }, [env, emptyBuffer()], exprs) in
                                          case xLabel of
                                            Builtin -> [false, env, exprsCode <+ BUILTIN(x, size(exprs))]
                                          | _       -> [false, env, exprsCode <+ CALL(xLabel, size(exprs))]
                                          esac
      | Builtin(x, exprs)        -> case exprs of
                                      {} -> [false, env, singletonBuffer(BUILTIN(x, 0))]
                                    | _  -> let [exprsLabel, env] = env.genLabel in
                                               let [exprsLabelUsed, env, exprsCode] = compileMany(exprsLabel, env, exprs) in
                                                  [false, env, exprsCode <+> label(exprsLabel, exprsLabelUsed) <+ BUILTIN(x,
                                                                       size(exprs))]
                                    esac
      | String(s)                -> [false, env, singletonBuffer(STRING(s))]
      | ElemRef(arr, i)          -> let [arrLab, env] = env.genLabel in
                                       let [arrLabUsed, env, arrCode] = compile(arrLab, env, arr) in
                                          let [labUsed, env, iCode] = compile(lab, env, i) in
                                             [labUsed, env, arrCode <+> label(arrLab, arrLabUsed) <+> iCode]
      | Elem(arr, i)             -> let [iLab, arrLab, env] = env.genLabels(2) in
                                       let [arrLabUsed, env, arrCode] = compile(arrLab, env, arr) in
                                          let [iLabUsed, env, iCode] = compile(iLab, env, i) in
                                             [false, env, arrCode <+> label(arrLab, arrLabUsed) <+> iCode <+> label(iLab,
                                                            iLabUsed) <+ ELEM]
      | Array(exprs)             -> let [lab, env] = env.genLabel in
                                       let [labUsed, env, code] = compileMany(lab, env, exprs) in
                                          [false,
                                           env,
                                           (singletonBuffer(CONST(size(exprs))) <+> code <+> label(lab, labUsed)) <+
                                           ARRAY(size(exprs))]
      | Sexp(t, exprs)           -> case exprs of
                                      {} -> [false, env, singletonBuffer(CONST(0)) <+ SEXP(t, 0)]
                                    | _  -> let [lab, env] = genLabel(env) in
                                               let [labUsed, env, argsCode] = compileMany(lab, env, exprs) in
                                                  [false, env, singletonBuffer(CONST(size(exprs))) <+>
                                                               argsCode <+>
                                                               label(lab, labUsed) <+
                                                               SEXP(t, size(exprs))]
                                    esac
      | Set(Ref(vr), expr)       -> let [lab, env] = env.genLabel in
                                       let [labUsed, env, code] = compile(lab, env, expr) in
                                          [false, env, code <+> label(lab, labUsed) <+ ST(lookupVal(env, vr))]
      | CaseOf(name, pairs, loc) -> var code = singletonBuffer(LD(lookupVal(env, name)));
                                    var varEnv = env;
                                    var finished = false;
                                    
                                    while 1 - finished do
                                       let head: tail = pairs in
                                          (
                                             let [true,
                                                  env,
                                                  matchCode] = compilePattern(lab, varEnv, head[0], head[1], code) in
                                                (
                                                   varEnv := env;
                                                   code := code <+> matchCode
                                                );
                                                pairs := tail;
                                                case pairs of
                                                  {} -> finished := true
                                                | _  -> skip
                                                esac
                                          )
                                    od;
                                    code := code <+ META(MF([loc.fst, loc.snd]));
                                    [true, varEnv, code]
      | _                        -> failure("compileSM not implemented for %s\n", stmt.string)
      esac
   }
   fun compilePattern (endLab, env, pattern, branch, code) {
      -- -> [code, maxLevel, env, m]
      fun compileLevel (env, pattern, labelMap, level) {
         var levelLab = findMap(labelMap, level)[0];
         fun compileMultiple (code, args, codeToAdd) {
            var i = 0;
            var varEnv = env;
            var m = labelMap;
            var maxLevel = level;
            
            while 1 - isEmpty(args) do
               let head: tail = args in
                  (
                     args := tail;
                     code := code <+> codeToAdd(i);
                     case findMap(m, level + 1) of
                       None -> let [lab, env] = genLabel(varEnv) in (
                        m := addMap(m, level + 1, lab);
                        varEnv := env
                       )
                     | _    -> skip
                     esac;
                     let [pattCode, newMaxLevel, newEnv, newMap] = compileLevel(varEnv, head, m, level + 1) in
                        (
                           code := code <+> pattCode;
                           varEnv := newEnv;
                           m := newMap;
                           maxLevel := max(newMaxLevel, maxLevel)
                        );
                        i := i + 1;
                        code := code <+ DROP
                  )
            od;
            [code, maxLevel, varEnv, m]
         }
         
         case pattern of
           Sexp(tag, args) -> var code = singletonBuffer(DUP) <+ PATT(Tag(tag, size(args))) <+ CJMP("z", levelLab);
                              compileMultiple(code, args, fun (i) {singletonBuffer(DUP) <+ CONST(i) <+ ELEM})
         | Array(args)     -> var code = singletonBuffer(DUP) <+ PATT(Array(size(args))) <+ CJMP("z", levelLab);
                              compileMultiple(code, args, fun (i) {singletonBuffer(DUP) <+ CONST(i) <+ ELEM <+ DUP})
         | WILDCARD        -> [emptyBuffer(), level, env, labelMap]
         | x@#val          -> [singletonBuffer(DUP) <+ CONST(x) <+ BINOP("==") <+ CJMP("z", findMap(labelMap, level)
                                                [0]), level, env, labelMap]
         esac
      }
      var varEnv = env;
      var caseCode;
      var dropCode = emptyBuffer();
      var m = emptyMap(fun (a, b) {-compare(a, b)});
      
      let [plab, env] = genLabel(varEnv) in
         m := addMap(m, 0, plab);
         varEnv := env;
         let [code, maxLevel, env, newMap] = compileLevel(varEnv, pattern, m, 0) in
            (
               caseCode := code;
               varEnv := env;
               m := newMap;
               while maxLevel >= 0 do
                  dropCode := dropCode <+ LABEL(findMap(m, maxLevel)[0], false);
                  if maxLevel > 0 then dropCode := dropCode <+ DROP fi;
                  maxLevel := maxLevel - 1
               od
            );
            let [eLabUsed, env, branchCode] = compile(endLab, varEnv, branch) in
               [true, env, (caseCode <+ DROP) <+> (branchCode <+ JMP(endLab)) <+> dropCode]
   }
   fun compileFunctions (env, main) {
      fun iterate (env, funList) {
         case funList of
           {}                            -> case getFuns(env) of
                                              [{}, env] -> emptyBuffer()
                                            | [fs, env] -> iterate(env, fs)
                                            esac
         | Fun(f, args, body, state): fs -> case genLabel(addArgs(beginFun(env, state), args)) of
                                              [endLab, env] -> case compile(endLab, env, body) of
                                                                 [endUsed, env, code] -> singletonBuffer(LABEL(f, false)) <+
                                                                                         BEGIN(f,
                                                                                               args.size,
                                                                                               getLocals(env)) <+>
                                                                                         code <+>
                                                                                         label(endLab, endUsed) <+
                                                                                         END <+>
                                                                                         iterate(env, fs)
                                                               esac
                                            esac
         esac
      }
      
      main <+> iterate(env, {})
   }
   
   let env = beginScope(initCompEnv()) in
      let env = addFun(env, "read", Builtin, 0) in
         let env = addFun(env, "write", Builtin, 1) in
            let env = addFun(env, "length", Builtin, 2) in
               let [endLab, env] = genLabel(env) in
                  case compile(endLab, env, stmt) of
                    [endLabUsed, env, code] -> getBuffer $ compileFunctions(env,
                                                 singletonBuffer(LABEL("main", false)) <+ BEGIN("main",
                                                       0,
                                                       getLocals(env)) <+> code <+> label(endLab, endLabUsed) <+ END)
                  esac
}